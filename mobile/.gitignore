.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.g.dart.bak

# IDE
.idea/
*.iml
*.iws
.vscode/

# Divers OS
.DS_Store
Thumbs.db

# Fichiers générés par les tests d'intégration / coverage
coverage/

